# Server-only secrets. Never use NEXT_PUBLIC_ for a Telegram token or chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional positive topic ID, for a Telegram forum group only.
TELEGRAM_MESSAGE_THREAD_ID=

# Full public origin, without trailing slash, e.g. your Vercel production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional but recommended for shared rate limiting and idempotency on Vercel.
# Without these, protection is best effort in the current process only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
